cat > .gitignore << 'EOF'
# dependencies
node_modules/

# next.js
.next/
out/

# production build / misc
dist/
build/

# env files (secrets)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.log

# OS files
.DS_Store

# IDE
.vscode/
.idea/

# misc
*.pem
EOF