+    extends React.CanvasHTMLAttributes<HTMLCanvasElement> {
+    penColor?: string;
+    backgroundColor?: string;
+    velocityFilterWeight?: number;
+    minWidth?: number;
+    maxWidth?: number;
+    throttle?: number;
+    minDistance?: number;
