+          width: boxW,
+          height: boxH,
+          borderColor: rgb(0.1, 0.1, 0.1),
+          borderWidth: 1,
+          color: rgb(1, 1, 1),
+          opacity: 0.95,
+        });
+
+        p.drawText("FES • Firma Electrónica", {
+          x: x + 8,
+          y: y + 30,
+          size: 9,
+          font: fontBold,
+          color: rgb(0.1, 0.1, 0.1),
+        });
+
+        p.drawText(`Código: ${auditCode.slice(0, 8)}…`, {
