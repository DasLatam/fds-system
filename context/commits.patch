+            text: `Documento finalizado: ${titleForEmail}\nFecha: ${completedAtForEmail}\nCódigo de auditoría: ${auditCodeForEmail}\nVerificación: ${verifyUrl2}${downloadUrl ? `\nDescarga: ${downloadUrl}` : ""}`,
+          });
