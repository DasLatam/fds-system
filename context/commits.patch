+function formatDate(iso?: string | null) {
+  if (!iso) return "—";
+  try {
+    return new Date(iso).toLocaleString();
+  } catch {
+    return iso;
+  }
+}
+
+type SignerRow = {
+  id: string;
+  email: string;
+  status: "pending" | "signed";
+  position: number | null;
+  email_sent_at: string | null;
+  opened_at: string | null;
+  signed_at: string | null;
