+        }
+
+        const label = `${String(s.signer_full_name || s.email || "Firmante")} • DNI ${String(s.signer_dni || "-")}`;
+        certPage.drawText(label, { x: MARGIN, y: cursorY, size: 11, font: fontBold, color: rgb(0, 0, 0) });
