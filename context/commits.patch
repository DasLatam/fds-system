+          });
+        } catch {}
+      }
+    }
+
+    return NextResponse.json({ ok: true, status: shouldFinalize ? "finalized" : "signed" });
+  } catch (e: any) {
+    const status = Number(e?.status || 500);
+    return NextResponse.json({ error: e?.message || "Unexpected error" }, { status });
+  }
+}
