+
+function dataUrlToPngBytes(dataUrl: string): Uint8Array {
+  const m = dataUrl.match(/^data:image\/png;base64,(.+)$/);
+  if (!m) throw new Error("Invalid signature dataUrl");
+  return Uint8Array.from(Buffer.from(m[1], "base64"));
