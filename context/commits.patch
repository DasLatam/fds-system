-function getIp(req: NextRequest) {
-  const xf = req.headers.get("x-forwarded-for");
-  if (xf) return xf.split(",")[0].trim();
-  const xr = req.headers.get("x-real-ip");
-  if (xr) return xr.trim();
-  return null;
-}
